@echo off
REM =====================================================================
REM  RvtVersion Property Handler - build script
REM
REM  Requires MinGW-w64 (g++). Either put it on PATH, or set MINGW_ROOT
REM  to its root directory (e.g. set MINGW_ROOT=C:\mingw64).
REM
REM  Outputs (all in out\):
REM    RvtVersionHandler.dll    the property handler (x64)
REM    rvtvhandlertest.exe      probe tester, works without registration
REM    rvtvpropschema.exe       propdesc register / unregister / verify
REM    rvtvdiag.exe             shell registration diagnostic tool
REM    rvtvwatch.exe            column watcher (GUI subsystem, no window)
REM    RvtVersionSetup.exe      single-file installer (embeds all of the above)
REM
REM  Why MinGW instead of MSVC:
REM    The local MSVC 14.51 install has bin/lib but no include; the Windows
REM    SDK has Catalogs/Debuggers but no Include/Lib. MinGW-w64 ships complete
REM    Win32 headers and import libraries, so it can produce an x64 DLL here.
REM
REM  NOTE: keep this file ASCII-only, CRLF, and WITHOUT a BOM.
REM        Chinese comments get mangled by the GBK console codepage and cmd
REM        then tries to execute them as commands.
REM =====================================================================
setlocal EnableDelayedExpansion

REM %~dp0 ends with a backslash; strip it. Otherwise -I "<dir>\" makes the
REM trailing \" escape the quote and gcc reports "no input files".
set "HERE=%~dp0"
if "%HERE:~-1%"=="\" set "HERE=%HERE:~0,-1%"

pushd "%HERE%"

if "%MINGW_ROOT%"=="" (
    where g++ >nul 2>&1
    if errorlevel 1 (
        echo [x] g++ not found.
        echo     Install MinGW-w64, or set MINGW_ROOT to its root directory,
        echo     for example:  set MINGW_ROOT=C:\mingw64
        popd ^& exit /b 1
    )
    set "CXX=g++"
    set "WINDRES=windres"
) else (
    set "CXX=%MINGW_ROOT%\bin\g++.exe"
    set "WINDRES=%MINGW_ROOT%\bin\windres.exe"
)

if not exist "out" mkdir "out"

set "CXXFLAGS=-Os -std=c++17 -municode -DUNICODE -D_UNICODE -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -ffunction-sections -fdata-sections"
set "LDFLAGS=-static -static-libgcc -static-libstdc++ -Wl,--gc-sections -s"
set "LIBS=-lole32 -loleaut32 -lshell32 -lshlwapi -luuid -lpropsys -ladvapi32 -luser32"

echo [*] Compiling version resource...
"%WINDRES%" -I "%HERE%" Version.rc -O coff -o "out\Version.res"
if errorlevel 1 ( echo [x] resource compile failed & popd & exit /b 1 )

echo [*] Compiling property handler DLL...
"%CXX%" -shared %CXXFLAGS% PropertyHandler.cpp "out\Version.res" RvtVersionHandler.def ^
    -o "out\RvtVersionHandler.dll" %LIBS% %LDFLAGS% -Wl,--kill-at
if errorlevel 1 ( echo [x] DLL compile failed & popd & exit /b 1 )

echo [*] Compiling probe tester...
"%CXX%" %CXXFLAGS% -Wno-cast-function-type HandlerTest.cpp ^
    -o "out\rvtvhandlertest.exe" %LIBS% %LDFLAGS%
if errorlevel 1 ( echo [x] tester compile failed & popd & exit /b 1 )

echo [*] Compiling propdesc schema tool...
"%CXX%" %CXXFLAGS% PropSchemaTool.cpp ^
    -o "out\rvtvpropschema.exe" %LIBS% %LDFLAGS%
if errorlevel 1 ( echo [x] schema tool compile failed & popd & exit /b 1 )

echo [*] Compiling shell diagnostic tool...
"%CXX%" %CXXFLAGS% ShellDiag.cpp ^
    -o "out\rvtvdiag.exe" %LIBS% %LDFLAGS%
if errorlevel 1 ( echo [x] diag tool compile failed & popd & exit /b 1 )

echo [*] Compiling column watcher...
REM ---- MUST be GUI subsystem (Subsystem=2), NOT console subsystem ----
REM Under the console subsystem, being launched from HKCU\...\Run pops up a
REM CMD window, and that window hosts the watcher process itself - closing it
REM kills the watcher, so the Revit column stops working.
REM -Wl,--subsystem,windows flips Subsystem from 3 to 2: the process never gets
REM a console, so there is no window and nothing to mis-close.
REM wmain stays a valid entry point under the GUI subsystem.
REM See the header of RvtColumnWatcher.cpp and docs/notes.md 5.6 for the full story.
"%CXX%" %CXXFLAGS% RvtColumnWatcher.cpp ^
    -o "out\rvtvwatch.exe" %LIBS% %LDFLAGS% -Wl,--subsystem,windows
if errorlevel 1 ( echo [x] watcher compile failed & popd & exit /b 1 )

REM ---- installer: embeds every artifact above as RCDATA ----
REM Setup.rc references out\RvtVersion.propdesc, so make sure it is there.
REM (The propdesc is authored in the source dir, not generated by the compiler.)
if not exist "out\RvtVersion.propdesc" copy /y "RvtVersion.propdesc" "out\RvtVersion.propdesc" >nul

echo [*] Compiling installer resources...
"%WINDRES%" -I "%HERE%" Setup.rc -O coff -o "out\Setup.res"
if errorlevel 1 ( echo [x] installer resource compile failed & popd & exit /b 1 )

echo [*] Compiling installer...
"%CXX%" %CXXFLAGS% Setup.cpp "out\Setup.res" ^
    -o "out\RvtVersionSetup.exe" %LIBS% %LDFLAGS%
if errorlevel 1 ( echo [x] installer compile failed & popd & exit /b 1 )

echo.
echo [+] Build complete
for %%F in ("out\RvtVersionHandler.dll" "out\rvtvhandlertest.exe" "out\rvtvpropschema.exe" "out\rvtvdiag.exe" "out\rvtvwatch.exe" "out\RvtVersionSetup.exe") do (
    echo     %%~nxF  %%~zF bytes
)
echo.
echo Install: run out\RvtVersionSetup.exe as administrator
popd
endlocal
